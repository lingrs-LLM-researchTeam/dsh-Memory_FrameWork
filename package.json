{
  "name": "dsh-memory-framework",
  "version": "0.3.2",
  "icon": "./docs/images/dsh-logo.svg",
  "description": "Evidence-backed memory, cross-session tasks and an editable Memory Dashboard for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh/plugin/dashboard",
    "dsh/plugin/skills",
    "dsh/core",
    "shared",
    "pyproject.toml",
    "cordis.patch.yml",
    "docs/images/dsh-logo.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory",
    "cordis",
    "plugin"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lingrs-LLM-researchTeam/dsh-Memory_FrameWork.git"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "build": "npm --prefix dsh/plugin run build",
    "test": "npm --prefix dsh/plugin test",
    "typecheck": "npm --prefix dsh/plugin run typecheck"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-api-gateway": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-api-remote-access": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-api-session-controller": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-goal": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
